{
  "openapi": "3.1.0",
  "info": {
    "title": "Growspace Vision API",
    "version": "1.0.0",
    "description": "Strict, stateless, single-image visual embedding contract. Home Assistant owns all baselines, comparisons, temporal scores, trends, and stored evaluation results."
  },
  "servers": [
    {
      "url": "http://growspace-vision.internal",
      "description": "Supervisor internal App network; no host port is published"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Report readiness to the Supervisor watchdog",
        "description": "This is the sole unauthenticated endpoint and reveals readiness only. It returns 200 when the configured model is loaded and the inference subsystem is operational. An occupied inference slot does not make the service unhealthy.",
        "security": [],
        "responses": {
          "200": {
            "description": "The service is ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "$ref": "#/components/responses/ModelNotLoaded"
          }
        }
      }
    },
    "/info": {
      "get": {
        "operationId": "getInfo",
        "summary": "Negotiate supported analysis schemas",
        "description": "This frozen bootstrap response remains V1-shaped even when no mutually supported analysis schema exists.",
        "responses": {
          "200": {
            "description": "Service identity, capabilities, and supported analysis schemas",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InfoResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/InternalFailure"
          }
        }
      }
    },
    "/models": {
      "get": {
        "operationId": "getModels",
        "summary": "List bundled models for one analysis schema",
        "parameters": [
          {
            "name": "schema_version",
            "in": "query",
            "required": true,
            "description": "An exact version selected from /info. V1 is 1.",
            "schema": {
              "type": "integer",
              "const": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Models compatible with the selected schema",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelsResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableRequest"
          },
          "500": {
            "$ref": "#/components/responses/InternalFailure"
          }
        }
      }
    },
    "/analyze": {
      "post": {
        "operationId": "analyzeImage",
        "summary": "Analyze one image",
        "description": "Returns an embedding or a first-class quality rejection. It never returns plant symptoms, plant-health judgments, temporal comparisons, anomaly scores, change scores, or trends.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/AnalyzeRequest"
              },
              "encoding": {
                "metadata": {
                  "contentType": "application/json"
                },
                "image": {
                  "contentType": "image/jpeg, image/png"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The image was analyzed or rejected by the quality gate",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyzeResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "413": {
            "$ref": "#/components/responses/ImageTooLarge"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedImageFormat"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableRequest"
          },
          "429": {
            "$ref": "#/components/responses/Busy"
          },
          "500": {
            "$ref": "#/components/responses/InternalFailure"
          },
          "503": {
            "$ref": "#/components/responses/ModelNotLoaded"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Per-install token generated by the App and delivered to Home Assistant through Supervisor discovery. It must never appear in URLs, logs, diagnostics, or error messages."
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "The Bearer token is missing or invalid",
        "x-error-codes": ["unauthorized"],
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "schema_version": 1,
              "error": {
                "code": "unauthorized",
                "message": "Authentication required"
              }
            }
          }
        }
      },
      "ImageTooLarge": {
        "description": "The encoded image exceeds 10 MiB or the decoded image exceeds 24 megapixels",
        "x-error-codes": ["image_too_large"],
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "UnsupportedImageFormat": {
        "description": "The image is not JPEG or PNG",
        "x-error-codes": ["unsupported_image_format"],
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "UnprocessableRequest": {
        "description": "The metadata, image body, schema version, or requested model is invalid",
        "x-error-codes": ["invalid_request", "unsupported_schema_version"],
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "Busy": {
        "description": "The sole inference slot is occupied; the App does not queue requests",
        "x-error-codes": ["busy"],
        "headers": {
          "Retry-After": {
            "description": "Advisory delay in seconds. V1 integrations do not retry automatically.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "InternalFailure": {
        "description": "Inference exceeded the App's 10-second deadline or an internal operation failed",
        "x-error-codes": ["internal_failure"],
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "ModelNotLoaded": {
        "description": "The configured or requested model is not loaded",
        "x-error-codes": ["model_not_loaded"],
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "SchemaVersion": {
        "type": "integer",
        "const": 1,
        "description": "Exact V1 wire schema. Any field or semantic change requires a new integer version."
      },
      "RequestId": {
        "type": "string",
        "format": "uuid",
        "description": "Ephemeral identifier generated by the App for one request. It is not persisted by the App."
      },
      "HealthResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema_version", "status"],
        "properties": {
          "schema_version": {
            "$ref": "#/components/schemas/SchemaVersion"
          },
          "status": {
            "type": "string",
            "const": "ready"
          }
        }
      },
      "InfoResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "service_name",
          "service_version",
          "supported_schema_versions",
          "capabilities",
          "limits"
        ],
        "properties": {
          "schema_version": {
            "$ref": "#/components/schemas/SchemaVersion"
          },
          "service_name": {
            "type": "string",
            "const": "growspace_manager_vision"
          },
          "service_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "supported_schema_versions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "capabilities": {
            "$ref": "#/components/schemas/Capabilities"
          },
          "limits": {
            "$ref": "#/components/schemas/OperationalLimits"
          }
        }
      },
      "Capabilities": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "single_image_analysis",
          "batch_analysis",
          "embeddings",
          "service_scoring",
          "regions"
        ],
        "properties": {
          "single_image_analysis": {
            "type": "boolean",
            "const": true
          },
          "batch_analysis": {
            "type": "boolean",
            "const": false
          },
          "embeddings": {
            "type": "boolean",
            "const": true
          },
          "service_scoring": {
            "type": "boolean",
            "const": false
          },
          "regions": {
            "type": "boolean",
            "const": false
          }
        }
      },
      "OperationalLimits": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "max_image_bytes",
          "max_decoded_pixels",
          "max_concurrency",
          "max_queue_depth",
          "inference_timeout_seconds"
        ],
        "properties": {
          "max_image_bytes": {
            "type": "integer",
            "const": 10485760
          },
          "max_decoded_pixels": {
            "type": "integer",
            "const": 24000000
          },
          "max_concurrency": {
            "type": "integer",
            "const": 1
          },
          "max_queue_depth": {
            "type": "integer",
            "const": 0
          },
          "inference_timeout_seconds": {
            "type": "integer",
            "const": 10
          }
        }
      },
      "ModelsResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema_version", "models"],
        "properties": {
          "schema_version": {
            "$ref": "#/components/schemas/SchemaVersion"
          },
          "models": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/ModelDescriptor"
            }
          }
        }
      },
      "ModelDescriptor": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model_id",
          "model_version",
          "embedding_dimension",
          "state"
        ],
        "properties": {
          "model_id": {
            "$ref": "#/components/schemas/ModelId"
          },
          "model_version": {
            "$ref": "#/components/schemas/ModelVersion"
          },
          "embedding_dimension": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          "state": {
            "type": "string",
            "enum": ["loaded", "unavailable"]
          }
        }
      },
      "ModelId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "description": "Opaque identity copied exactly from /models."
      },
      "ModelVersion": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "description": "Opaque artifact version copied exactly from /models. A changed version starts a new HA Baseline Bucket."
      },
      "AnalyzeRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metadata", "image"],
        "properties": {
          "metadata": {
            "$ref": "#/components/schemas/AnalyzeMetadata"
          },
          "image": {
            "type": "string",
            "format": "binary",
            "description": "One JPEG or PNG image. The encoded body is at most 10 MiB and the decoded image at most 24 megapixels."
          }
        }
      },
      "AnalyzeMetadata": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "camera_id",
          "growspace_id",
          "captured_at",
          "light_state",
          "model_id",
          "model_version"
        ],
        "properties": {
          "schema_version": {
            "$ref": "#/components/schemas/SchemaVersion"
          },
          "camera_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "description": "Opaque Home Assistant camera identifier used only for request correlation."
          },
          "growspace_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "description": "Opaque Growspace identifier used only for request correlation."
          },
          "captured_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$",
            "description": "UTC RFC 3339 timestamp."
          },
          "light_state": {
            "type": "string",
            "enum": ["on", "off", "unknown"],
            "description": "Capture-time light-cycle state. This is the only non-image observation permitted."
          },
          "model_id": {
            "$ref": "#/components/schemas/ModelId"
          },
          "model_version": {
            "$ref": "#/components/schemas/ModelVersion"
          }
        }
      },
      "AnalyzeResponse": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/AnalyzedResponse"
          },
          {
            "$ref": "#/components/schemas/RejectedResponse"
          }
        ]
      },
      "AnalyzedResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "request_id",
          "status",
          "model",
          "embedding",
          "quality",
          "regions"
        ],
        "properties": {
          "schema_version": {
            "$ref": "#/components/schemas/SchemaVersion"
          },
          "request_id": {
            "$ref": "#/components/schemas/RequestId"
          },
          "status": {
            "type": "string",
            "const": "analyzed"
          },
          "model": {
            "$ref": "#/components/schemas/ModelIdentity"
          },
          "embedding": {
            "$ref": "#/components/schemas/Embedding"
          },
          "quality": {
            "$ref": "#/components/schemas/AcceptedQuality"
          },
          "regions": {
            "$ref": "#/components/schemas/EmptyRegions"
          }
        }
      },
      "RejectedResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "request_id",
          "status",
          "quality",
          "regions"
        ],
        "properties": {
          "schema_version": {
            "$ref": "#/components/schemas/SchemaVersion"
          },
          "request_id": {
            "$ref": "#/components/schemas/RequestId"
          },
          "status": {
            "type": "string",
            "const": "rejected"
          },
          "quality": {
            "$ref": "#/components/schemas/RejectedQuality"
          },
          "regions": {
            "$ref": "#/components/schemas/EmptyRegions"
          }
        }
      },
      "ModelIdentity": {
        "type": "object",
        "additionalProperties": false,
        "required": ["model_id", "model_version"],
        "properties": {
          "model_id": {
            "$ref": "#/components/schemas/ModelId"
          },
          "model_version": {
            "$ref": "#/components/schemas/ModelVersion"
          }
        }
      },
      "Embedding": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension", "values"],
        "properties": {
          "dimension": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096,
            "description": "Must equal both values.length and the selected model's embedding_dimension."
          },
          "values": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4096,
            "items": {
              "type": "number"
            },
            "description": "Finite JSON numbers only; NaN and infinity are invalid JSON."
          }
        }
      },
      "QualitySignals": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mean_luminance",
          "clipped_pixel_fraction",
          "mean_absolute_gradient"
        ],
        "properties": {
          "mean_luminance": {
            "type": "number",
            "minimum": 0,
            "maximum": 255,
            "description": "Mean 8-bit BT.601 luminance Y = 0.299R + 0.587G + 0.114B over all decoded pixels."
          },
          "clipped_pixel_fraction": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Fraction of decoded pixels whose 8-bit BT.601 luminance is strictly greater than 245."
          },
          "mean_absolute_gradient": {
            "type": "number",
            "minimum": 0,
            "maximum": 255,
            "description": "On the 8-bit luminance plane: (mean(abs(diff(Y, x))) + mean(abs(diff(Y, y)))) / 2."
          }
        }
      },
      "QualityReason": {
        "type": "string",
        "enum": [
          "too_dark",
          "overexposed",
          "low_detail",
          "light_state_mismatch"
        ]
      },
      "AcceptedQuality": {
        "type": "object",
        "additionalProperties": false,
        "required": ["signals", "reasons"],
        "properties": {
          "signals": {
            "$ref": "#/components/schemas/QualitySignals"
          },
          "reasons": {
            "type": "array",
            "maxItems": 0,
            "items": {
              "$ref": "#/components/schemas/QualityReason"
            }
          }
        }
      },
      "RejectedQuality": {
        "type": "object",
        "additionalProperties": false,
        "required": ["signals", "reasons"],
        "properties": {
          "signals": {
            "$ref": "#/components/schemas/QualitySignals"
          },
          "reasons": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/components/schemas/QualityReason"
            }
          }
        }
      },
      "EmptyRegions": {
        "type": "array",
        "maxItems": 0,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {}
        },
        "description": "Reserved for a later schema version. V1 requires exactly []."
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schema_version", "error"],
        "properties": {
          "schema_version": {
            "$ref": "#/components/schemas/SchemaVersion"
          },
          "request_id": {
            "$ref": "#/components/schemas/RequestId"
          },
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "unauthorized",
              "unsupported_image_format",
              "image_too_large",
              "invalid_request",
              "unsupported_schema_version",
              "model_not_loaded",
              "busy",
              "internal_failure"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "Safe human-readable summary. It contains no token, filesystem path, traceback, image bytes, or metadata beyond the request_id."
          }
        }
      }
    }
  }
}
